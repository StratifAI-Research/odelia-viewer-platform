# Merge these settings into your existing .env; do not overwrite other settings.
# Use the full image reference printed by the trained-model workflow, preferably
# an immutable registry digest. Images must already contain the trained weights.
# No HF token is needed to run them. Empty values deliberately fail Compose.
MST_IMAGE=
AGALDRAN_IMAGE=
BCN_AIM_IMAGE=
LME_ABMIL_IMAGE=
DIVIDE_AND_CONQUER_IMAGE=

# Optional: defaults to the pinned current viewer build in docker-compose.yml.
# VIEWER_TAG=2.2.0
# VIEWER_IMAGE=local-viewer:verified-commit
# MODEL_DEVICE=cpu

# Optional host-port override if another local service occupies 5561.
# DIVIDE_AND_CONQUER_PORT=5565
