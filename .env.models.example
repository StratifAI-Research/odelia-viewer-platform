# Optional overrides; docker-compose.yml already pins published trained images.
# No .env or HF token is needed for the default model deployment.
# To select a different trained release, uncomment its full image reference below.
# Empty or unset values use the pinned defaults; merge into an existing .env.
# Repository: stratifai/odelia-classification-mst
# MST_IMAGE=stratifai/odelia-classification-mst@sha256:4e0ffc4c72db7cbe87ec64aa90c131bbd8df224fbfb76ea41c4e5a39d35592ab
# Repository: stratifai/odelia-classification-agaldran
# AGALDRAN_IMAGE=stratifai/odelia-classification-agaldran@sha256:aa7bf977110dc0ad6c006b3dc416449ea1ff172e7c8c697420bee947b7a198fa
# Repository: stratifai/odelia-classification-bcnaim
# BCN_AIM_IMAGE=stratifai/odelia-classification-bcnaim@sha256:72607655e1bfa934be58cca85a867440f5c60498a48c5194e656c65f0aa72e9e
# Repository: stratifai/odelia-classification-lmeabmil
# LME_ABMIL_IMAGE=stratifai/odelia-classification-lmeabmil@sha256:5962c7a81c5a88ef14ee3da40786dce126c4ffa8885684b471ac6a166c34ab64
# Repository: stratifai/odelia-classification-divideandconquer
# DIVIDE_AND_CONQUER_IMAGE=stratifai/odelia-classification-divideandconquer@sha256:e3f05d99df32708c5c43b3d22487c734986a833c5a3a2d706910ad7097cd62dc

# Optional: defaults to the pinned current viewer build in docker-compose.yml.
# VIEWER_TAG=2.3.0@sha256:8fee8d3ab400342e3c31ba9648dda4b7bf698657c8a7ae0ab7060222bd416647
# VIEWER_IMAGE=local-viewer:verified-commit
# Platform image overrides accept a full reference, including a custom registry.
# ORTHANC_VIEWER_IMAGE=myorg/odelia-orthanc-viewer:dev
# ORTHANC_ROUTER_IMAGE=myorg/odelia-orthanc-router:dev
# CHAT_IMAGE=myorg/odelia-chat:dev
# TAG=dev  # Optional shared tag for Orthanc/chat images under stratifai.
# DOCKER_HUB_USERNAME only selects the namespace for locally built model previews.
# MODEL_DEVICE=cpu

# Optional host-port override if another local service occupies 5561.
# DIVIDE_AND_CONQUER_PORT=5565
